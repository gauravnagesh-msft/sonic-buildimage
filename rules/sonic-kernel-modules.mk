# Platform-independent SONiC kernel modules

KDUMP_RUNTIME_MODULE = kdump_runtime.ko
KDUMP_RUNTIME_SIGNED_MODULE = kdump_runtime.signed.ko

$(KDUMP_RUNTIME_MODULE)_SRC_PATH = $(SRC_PATH)/sonic-kernel-modules
$(KDUMP_RUNTIME_MODULE)_DEPENDS += $(LINUX_HEADERS) $(LINUX_HEADERS_COMMON)

$(KDUMP_RUNTIME_SIGNED_MODULE)_SRC_PATH = $(SRC_PATH)/sonic-kernel-modules
$(KDUMP_RUNTIME_SIGNED_MODULE)_DEPENDS += $(LINUX_HEADERS) $(LINUX_HEADERS_COMMON)

SONIC_MAKE_FILES += $(KDUMP_RUNTIME_MODULE)
SONIC_MAKE_FILES += $(KDUMP_RUNTIME_SIGNED_MODULE)

.PHONY: $(KDUMP_RUNTIME_MODULE) $(KDUMP_RUNTIME_SIGNED_MODULE)
$(KDUMP_RUNTIME_MODULE): $(FILES_PATH)/$(KDUMP_RUNTIME_MODULE)
$(KDUMP_RUNTIME_SIGNED_MODULE): $(FILES_PATH)/$(KDUMP_RUNTIME_SIGNED_MODULE)
